# ==============================================================
# CardioAI Environment Configuration
# ==============================================================

# Option A (Default): Built-in Zero-Latency Serverless ML Engine
# Leave NEXT_PUBLIC_API_URL and PYTHON_API_URL empty or unset.
# The application will execute real trained model inference directly in Next.js.
NEXT_PUBLIC_API_URL=

# Option B: Dedicated Python ML Microservice (FastAPI)
# Set when running FastAPI backend locally or deployed to Render/Railway/Fly.io
# PYTHON_API_URL=http://localhost:8000
PYTHON_API_URL=
